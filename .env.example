# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Only the URL and the publishable/anon key belong here - never the secret/
# service-role key. This app is a client-side SPA; anything in a VITE_*
# variable ships to every visitor's browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
